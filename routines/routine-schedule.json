{
  "_meta": {
    "purpose": "Canonical source of truth for the Orryx routine fleet schedule + dependency DAG. The live scheduler is ALIGNED to this file, not the reverse. Human-readable companion: ROUTINES.md.",
    "version": 1,
    "created": "2026-06-28",
    "timezone": "Australia/Brisbane (AEST, UTC+10)",
    "ordering_model": "Wall-clock cron staggers by layer give correct order on a normal day; CORRECTNESS rests on the per-consumer producer pre-check (see _shared/PRODUCER_PRECHECK.md), NOT on the clock. A consumer whose same-day required input is absent SKIPs rather than consuming stale/older data.",
    "cadence_rationale": "Daily is justified only when the input changes daily AND a day of staleness causes harm. Freshness-critical (security, safety, repo state) + the operator-facing governance spine stay daily; strategic/evolution routines that synthesize slow-moving internal state run weekly/fortnightly or are condition-triggered with a NO_CHANGE skip.",
    "circular_dep_adr": "daily-planner <-> orchestration is broken by TEMPORAL SPLIT: orchestration runs night-of (N, 23:xx) over the full same-day cohort and SEEDS the next morning; daily-planner (N+1 morning) consumes the PRIOR-NIGHT master-operating-plan(N). The edge is one-directional across days: producers(N) -> orchestration(N) -> daily-planner(N+1). Do NOT move orchestration to morning (would re-introduce the spine-gap race).",
    "layers": {
      "L0": "root producers \u2014 scan ground truth directly, never consume sibling reports",
      "L1": "synthesis producers \u2014 consume L0, emit domain intelligence",
      "L2": "specialised consumers \u2014 single-domain synthesis over L1",
      "L3": "governance synthesizers \u2014 consume the full L2 cohort",
      "L4": "meta/evolution \u2014 weekly/fortnightly improvement loops",
      "L5": "state/continuity \u2014 eod, memory, knowledge",
      "L6": "executors/propagators \u2014 act on decisions (gated)"
    }
  },
